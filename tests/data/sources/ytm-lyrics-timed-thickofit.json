{"contents":{"elementRenderer":{"newElement":{"type":{"componentType":{"model":{"timedLyricsModel":{"lyricsData":{"timedLyricsData":[{"lyricLine":"I'm in the thick of it, everybody knows","cueRange":{"startTimeMilliseconds":"1110","endTimeMilliseconds":"4030","metadata":{"id":"0"}}},{"lyricLine":"They know me where it snows, I skied in and they froze","cueRange":{"startTimeMilliseconds":"4030","endTimeMilliseconds":"7510","metadata":{"id":"1"}}},{"lyricLine":"I don't know no nothin' 'bout no ice, I'm just cold","cueRange":{"startTimeMilliseconds":"7510","endTimeMilliseconds":"10730","metadata":{"id":"2"}}},{"lyricLine":"Forty somethin' milli' subs or so, I've been told","cueRange":{"startTimeMilliseconds":"10730","endTimeMilliseconds":"14300","metadata":{"id":"3"}}},{"lyricLine":"I'm in my prime but this ain't even final form","cueRange":{"startTimeMilliseconds":"14300","endTimeMilliseconds":"17470","metadata":{"id":"4"}}},{"lyricLine":"They knocked me down, but still, my feet, they find the floor","cueRange":{"startTimeMilliseconds":"17470","endTimeMilliseconds":"20800","metadata":{"id":"5"}}},{"lyricLine":"I went from living rooms straight up to sold-out tours","cueRange":{"startTimeMilliseconds":"20800","endTimeMilliseconds":"24320","metadata":{"id":"6"}}},{"lyricLine":"Life's a fight, but trust, I'm ready for the war","cueRange":{"startTimeMilliseconds":"24320","endTimeMilliseconds":"27630","metadata":{"id":"7"}}},{"lyricLine":"Whoa-oh-oh","cueRange":{"startTimeMilliseconds":"27630","endTimeMilliseconds":"30710","metadata":{"id":"8"}}},{"lyricLine":"This is how the story goes","cueRange":{"startTimeMilliseconds":"30710","endTimeMilliseconds":"33980","metadata":{"id":"9"}}},{"lyricLine":"Whoa-oh-oh","cueRange":{"startTimeMilliseconds":"33980","endTimeMilliseconds":"36870","metadata":{"id":"10"}}},{"lyricLine":"I guess this is how the story goes","cueRange":{"startTimeMilliseconds":"36870","endTimeMilliseconds":"40580","metadata":{"id":"11"}}}]}}}}}}}}}